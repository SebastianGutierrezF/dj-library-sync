# Spotify app credentials: https://developer.spotify.com/dashboard
#
# CLIENT_ID is required for everything.
# CLIENT_SECRET is only used by `djls match`, which searches via the Client
# Credentials flow and needs no user account.
#
# `djls login` / `djls push` use Authorization Code + PKCE and never send a
# secret. For those, register this EXACT redirect URI on your app first:
#
#   http://127.0.0.1:8888/callback
#
# Spotify rejects `localhost` as a redirect host — it must be the 127.0.0.1 form.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
